# Leave empty to use the same-origin Express API through Vite's proxy.
VITE_API_BASE_URL=

# Gemini OOTD/image analysis. Keep this server-side only.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Decart Lucy realtime virtual try-on provider.
# Leave DECART_API_KEY empty to return mock Lucy token metadata in local demo.
DECART_API_KEY=
LUCY_MODEL=lucy-vton-3
LUCY_TOKEN_TTL_SEC=60
LUCY_MAX_PREVIEW_SEC=12

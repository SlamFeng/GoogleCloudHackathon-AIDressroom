# Leave empty to use the same-origin Express API through Vite's proxy.
VITE_API_BASE_URL=
# auto uses Gemini when configured and falls back to mock locally.
VITE_ANALYSIS_MODE=auto

# Gemini OOTD/image analysis. Keep this server-side only.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1
GEMINI_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Decart Lucy realtime virtual try-on provider.
# Leave DECART_API_KEY empty to return mock Lucy token metadata in local demo.
DECART_API_KEY=
LUCY_MODEL=lucy-vton-3
LUCY_TOKEN_TTL_SEC=60
LUCY_MAX_PREVIEW_SEC=12

# Inventory subsystem.
# INVENTORY_BACKEND=memory  -> in-memory, auto-seeded, zero setup (default; used for tests).
# INVENTORY_BACKEND=firestore -> Cloud Firestore or the local emulator (must be seeded first).
INVENTORY_BACKEND=memory
# How long an Agent's reservation hold survives before the sweeper releases it.
INVENTORY_RESERVATION_TTL_SEC=900
# For the firestore backend. When FIRESTORE_EMULATOR_HOST is set, the SDK talks to the local emulator.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# FIRESTORE_EMULATOR_HOST=localhost:8080

{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/agent/**",
              "components/core/**",
              "components/forms/**",
              "components/status/**",
              "components/tryon/**",
              "ui_kits/entrance_screen/**",
              "ui_kits/mirror/**",
              "ui_kits/staff_ipad/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|IBM Plex Mono|Noto Sans SC))/i]",
        "message": "Font not provided by the design system. Available: Archivo, IBM Plex Mono, Noto Sans SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='AhaStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|value|key|ref|className|style|children)$/]",
        "message": "<AhaStep> doesn't accept that prop. Declared props: key, label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|icon|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, icon, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|children|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentConstraintLike'] > JSXAttribute > JSXIdentifier[name!=/^(?:dimension|value|reason|key|ref|className|style|children)$/]",
        "message": "<AgentConstraintLike> doesn't accept that prop. Declared props: dimension, value, reason."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:dimension|label|key|ref|className|style|children)$/]",
        "message": "<FeedbackTag> doesn't accept that prop. Declared props: dimension, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hairline'] > JSXAttribute > JSXIdentifier[name!=/^(?:vertical|inset|key|ref|className|style|children)$/]",
        "message": "<Hairline> doesn't accept that prop. Declared props: vertical, inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='LanguageSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|langs|key|ref|className|style|children)$/]",
        "message": "<LanguageSwitch> doesn't accept that prop. Declared props: value, onChange, langs."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicroLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|as|children|key|ref|className|style|children)$/]",
        "message": "<MicroLabel> doesn't accept that prop. Declared props: tone, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MicroLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|ink|accent)$/]",
        "message": "<MicroLabel> tone must be one of 'muted' | 'ink' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|unit|min|max|key|ref|className|style|children)$/]",
        "message": "<NumberField> doesn't accept that prop. Declared props: value, onChange, unit, min, max."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|size|countUp|currency|key|ref|className|style|children)$/]",
        "message": "<PriceTag> doesn't accept that prop. Declared props: amount, size, countUp, currency."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<PriceTag> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PrivacyChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<PrivacyChip> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductLike'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|category|price_yen|colors|style_tags|fit|key|ref|className|style|children)$/]",
        "message": "<ProductLike> doesn't accept that prop. Declared props: name, category, price_yen, colors, style_tags, fit."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductLike'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:outerwear|top|bottom|dress|shoes|accessory)$/]",
        "message": "<ProductLike> category must be one of 'outerwear' | 'top' | 'bottom' | 'dress' | 'shoes' | 'accessory'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecommendationSetLike'] > JSXAttribute > JSXIdentifier[name!=/^(?:set_id|round|rec_type|reason|products|key|ref|className|style|children)$/]",
        "message": "<RecommendationSetLike> doesn't accept that prop. Declared props: set_id, round, rec_type, reason, products."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecTypeLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:recType|key|ref|className|style|children)$/]",
        "message": "<RecTypeLabel> doesn't accept that prop. Declared props: recType."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|size|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<SegmentedControl> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|active|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: label, value, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolCallRecordLike'] > JSXAttribute > JSXIdentifier[name!=/^(?:tool|input|output|called_at|key|ref|className|style|children)$/]",
        "message": "<ToolCallRecordLike> doesn't accept that prop. Declared props: tool, input, output, called_at."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolStatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|key|ref|className|style|children)$/]",
        "message": "<ToolStatusChip> doesn't accept that prop. Declared props: status, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TryOnStage'] > JSXAttribute > JSXIdentifier[name!=/^(?:phase|baseSrc|outfitSrc|badge|labelJa|labelEn|idleHint|children|key|ref|className|style|children)$/]",
        "message": "<TryOnStage> doesn't accept that prop. Declared props: phase, baseSrc, outfitSrc, badge, labelJa, labelEn, idleHint, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
